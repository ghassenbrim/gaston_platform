DATABASE_URL=
DIRECT_URL=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TIMEOUT=10000

# Used for SMS and, when present, transactional verification emails via Brevo HTTP API.
BREVO_API_KEY=
BREVO_SMS_SENDER=Gaston

CLEANUP_SECRET=

# Optional on Railway when you attach a persistent volume.
# Set this to the Railway volume mount path, for example:
# UPLOAD_DIR=/app/uploads
UPLOAD_DIR=
